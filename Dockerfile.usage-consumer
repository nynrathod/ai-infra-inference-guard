# Build stage: compile a static usage-consumer binary.
FROM golang:1.23-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/usage-consumer ./cmd/usage-consumer

# Runtime stage: distroless, non-root, no shell.
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/usage-consumer /usr/local/bin/usage-consumer
USER nonroot
ENTRYPOINT ["/usr/local/bin/usage-consumer"]